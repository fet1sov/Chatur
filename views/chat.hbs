<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Youtube Chat</title>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/socket.io/4.8.1/socket.io.min.js" integrity="sha512-8ExARjWWkIllMlNzVg7JKq9RKWPlJABQUNq6YvAjE/HobctjH/NA+bSiDMDvouBVjp4Wwnf1VP1OEv7Zgjtuxw==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>

    <script type="module">

        let address = "http://localhost:{{{port}}}"; 
        let socket = io.connect(address);

        socket.on('youtubeMessage', function(msg) {
            const messageList = document.querySelector(".messages");

            let userMessage = stripHtml(msg.messageText); // Preventing any HTML code in chat message
            let words = userMessage.split(" ");

            /* Inserting an emojis in messages */
            for (let i = 0; i < words.length; i++)
            {
                if (emojiExists(`${address}/_resources/emoji/${words[i]}.gif`)) 
                {
                    words[i] = `<img class="emoji" src="_resources/emoji/${words[i]}.gif">`;
                }

                if (emojiExists(`${address}/_resources/emoji/${words[i]}.png`)) 
                {
                    words[i] = `<img class="emoji" src="_resources/emoji/${words[i]}.png">`
                }
            }
            
            userMessage = words.join(" ");

            if (msg.roles.indexOf('moderator') != -1) {
                messageList.insertAdjacentHTML('beforeend', `
                <li class="yt-message" data-id="${msg.messageId}">
                    <div class="yt-user-badges">
                        <img class="rounded-badge" src="_resources/_badges/moderator.png">
                    </div>
                    
                    <div class="yt-user-name moder">${msg.nickname}: </div>
                    
                    <div class="yt-user-message">${userMessage}</div>
                </li>
                `);
            } else if (msg.roles.indexOf('broadcaster') != -1) {
                messageList.insertAdjacentHTML('beforeend', `
                <li class="yt-message" data-id="${msg.messageId}">
                    <div class="yt-user-badges">
                        <img width="21" height="46" style="margin-right: 10px;" src="_resources/_badges/broadcaster.gif">
                    </div>
                    
                    <div class="yt-user-name broadcaster">${msg.nickname}: </div>
                    
                    <div class="yt-user-message">${userMessage}</div>
                </li>
                `);
            } else if (msg.roles.indexOf('verified') != -1) {
                messageList.insertAdjacentHTML('beforeend', `
                <li class="yt-message" data-id="${msg.messageId}">
                    <div class="yt-user-badges">
                        <img class="badge" src="_resources/_badges/verified.gif">
                    </div>
                    
                    <div class="yt-user-name verified">${msg.nickname}: </div>
                    
                    <div class="yt-user-message">${userMessage}</div>
                </li>
                `);
            } else {
                messageList.insertAdjacentHTML('beforeend', `
                <li class="yt-message" data-id="${msg.messageId}">
                    <div class="yt-user-badges">

                    </div>
                    
                    <div class="yt-user-name">${msg.nickname}: </div>
                    
                    <div class="yt-user-message">${userMessage}</div>
                </li>
                `);
            }
        });

        socket.on('youtubeMessageDelete', function(msg) {
            document.querySelector("li[data-id=" + msg.messageId + "]").remove();
        });
    </script>

    <style>
        body {
            font-family: "Roboto";
            line-height: 18px;

            color: #FFFFFF;

            text-shadow: 2px 2px 0 #000000, 
            2px -2px 0 #000000, 
            -2px 2px 0 #000000, 
            -2px -2px 0 #000000, 
            2px 0px 0 #000000, 
            0px 2px 0 #000000, 
            -2px 0px 0 #000000, 
            0px -2px 0 #000000;


            overflow: hidden;
            background-color: rgba(0, 0, 0, 0);
        }

        ul {
            list-style: none;
            display: flex;
            flex-direction: column-reverse;
        }

        .emoji {
            width: 42px;
            height: 42px;
            vertical-align: middle;
        }

        .badge {
        width: 32px;
        height: 32px;
        margin-right: 10px;
        vertical-align: middle;
        }

        .rounded-badge {
        width: 32px;
        height: 32px;
        border-radius: 20%;
        margin-right: 10px;
        vertical-align: middle;
        }

        .rounded-badge-big {
        width: 48px;
        height: 48px;
        border-radius: 20%;
        margin-right: 10px;
        vertical-align: middle;
        }

        .yt-user-name {
            margin-right: 5px;
            color:#cbcbcb;
        }

        .moder {
            color: #44D80F;
            text-shadow: 0 0 5px #44D80F, 
            0 0 10px #44D80F, 
            0 0 15px #44D80F, 
            0 0 20px #44D80F, 
            0 0 30px #44D80F, 
            0 0 40px #44D80F, 
            0 0 55px #44D80F, 
            0 0 75px #44D80F;
        }

        .broadcaster {
            text-shadow: 2px 2px 0 #000000, 
            2px -2px 0 #000000, 
            -2px 2px 0 #000000, 
            -2px -2px 0 #000000, 
            2px 0px 0 #000000, 
            0px 2px 0 #000000, 
            -2px 0px 0 #000000, 
            0px -2px 0 #000000;
            animation: colorRotate .5s linear 0s infinite;
        }

        .membership {
        color: #0099ff;
        font-weight: bold;

        text-shadow: 0 0 5px #0099ff, 
            0 0 10px #0099ff, 
            0 0 15px #0099ff, 
            0 0 20px #0099ff, 
            0 0 30px #0099ff, 
            0 0 40px #0099ff, 
            0 0 55px #0099ff, 
            0 0 75px #0099ff;
        }

        .membershipLVL2 {
        font-weight: bold;
        color: #fc9015;
        text-transform: uppercase;
        animation: blur .75s ease-out infinite;
        text-shadow: 0px 0px 5px #fc9015, 0px 0px 7px #fc9015;
        }

        @keyframes blur {
        from {
            text-shadow:0px 0px 10px #fc9015,
            0px 0px 10px #fc9015, 
            0px 0px 25px #fc9015,
            0px 0px 25px #fc9015,
            0px 0px 25px #fc9015,
            0px 0px 25px #fc9015,
            0px 0px 25px #fc9015,
            0px 0px 25px #fc9015,
            0px 0px 50px #fc9015,
            0px 0px 50px #fc9015,
            0px 0px 50px #cf6f01,
            0px 0px 150px #cf6f01,
            0px 10px 100px #cf6f01,
            0px 10px 100px #cf6f01,
            0px 10px 100px #cf6f01,
            0px 10px 100px #cf6f01,
            0px -10px 100px #cf6f01,
            0px -10px 100px #cf6f01;
        }
        }

        @keyframes colorRotate {
        from {
            color: #6666ff;
        }
        10% {
            color: #0099ff;
        }
        50% {
            color: #00ff00;
        }
        75% {
            color: #ff3399;
        }
        100% {
            color: #6666ff;
        }
        }

        .messages {
            height: calc(100vh - 15px);
            display: flex;
            flex-direction: column;
            justify-content: flex-end;
            flex-wrap: nowrap;
        }

        .yt-message {
            display: flex;
            justify-content: flex-start;
            flex-direction: row;
            align-items: center;
            vertical-align: middle;

            margin-bottom: 2px;

            animation: anim 15400ms;
            animation-fill-mode: both;
        }

        .yt-user-message {
            vertical-align: middle;
        }

        @keyframes anim {
            0% { opacity: 0; transform: translateY(16px); }
            1.2987012987012987% { opacity: 1; transform: none;}
            98.7012987012987% { opacity: 1; transform: none;}
            100% { opacity: 0; transform: translateY(-16px); }
        }
    </style>
</head>
<body style="font-size:  configuration.fontSize px;">
    <ul class="messages">
        <li class="yt-message" data-id="0">
            <div class="yt-user-name">Test: </div>
            
            <div class="yt-user-message">TEST MESSAGE CHAT IS WORKING</div>
        </li>
    </ul>
</body>
</html>